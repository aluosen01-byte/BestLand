/**detail.wxss —— 构建产物（由 detail.less 编译而来）**/
.page {
  background: #F7F5F0;
  padding-bottom: 40rpx;
}

/* ============ 图片区 ============ */
.gallery {
  position: relative;
  background: #FFFFFF;
  padding-bottom: 24rpx;
}

.gallery__swiper {
  width: 100%;
  height: 620rpx;
  background: #F2F5F5;
}

.gallery__item {
  width: 100%;
  height: 100%;
  padding: 30rpx;
}

.gallery__dots {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
}

.gallery__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: #E2DDD3;
  margin: 0 8rpx;
  transition: width 0.2s;
}

.gallery__dot.is-on {
  width: 32rpx;
  background: #1F3A44;
}

.gallery__counter {
  position: absolute;
  right: 32rpx;
  top: 32rpx;
  font-size: 22rpx;
  color: #3A4348;
  background: rgba(255, 255, 255, 0.86);
  height: 44rpx;
  line-height: 44rpx;
  padding: 0 20rpx;
  border-radius: 22rpx;
}

/* ============ 标题 ============ */
.intro {
  background: #FFFFFF;
  padding: 36rpx 32rpx 40rpx;
  display: flex;
  flex-direction: column;
}

.intro__head {
  display: flex;
  align-items: center;
}

.intro__name {
  font-size: 44rpx;
  font-weight: 700;
  color: #1D2226;
  letter-spacing: 1rpx;
}

.intro__badge {
  margin-left: 18rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #FFFFFF;
  background: #1F3A44;
  height: 36rpx;
  line-height: 36rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
}

.intro__badge.is-accent {
  background: #F0A22E;
}

.intro__tagline {
  margin-top: 14rpx;
  font-size: 28rpx;
  color: #5C666B;
}

.intro__tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 28rpx;
}

/* ============ 技术参数 ============ */
.specs {
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(31, 58, 68, 0.08);
  padding: 4rpx 28rpx;
}

.spec {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #E2DDD3;
}

.spec:last-child {
  border-bottom: none;
}

.spec__label {
  width: 190rpx;
  flex: none;
  font-size: 26rpx;
  color: #5C666B;
}

.spec__value {
  flex: 1;
  font-size: 26rpx;
  color: #1D2226;
  font-weight: 500;
}

.note {
  display: block;
  margin-top: 18rpx;
  font-size: 21rpx;
  color: #8A9298;
  line-height: 1.6;
}

/* ============ 型号 ============ */
.model {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx;
  border-bottom: 1rpx solid #E2DDD3;
}

.model:last-child {
  border-bottom: none;
}

.model__left {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.model__name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D2226;
}

.model__spec {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #5C666B;
}

.model__ask {
  flex: none;
  margin-left: 24rpx;
  height: 60rpx;
  line-height: 58rpx;
  padding: 0 32rpx;
  border-radius: 30rpx;
  border: 2rpx solid #1F3A44;
  color: #1F3A44;
  font-size: 25rpx;
  font-weight: 600;
}

.model__tip {
  padding: 24rpx 28rpx 28rpx;
  font-size: 21rpx;
  color: #C97A12;
  background: #FBF6EA;
  line-height: 1.65;
}

/* ============ 场景 ============ */
.scenes {
  display: flex;
  flex-wrap: wrap;
}

.scene {
  font-size: 26rpx;
  color: #3A4348;
  background: #FFFFFF;
  border: 1rpx solid #E2DDD3;
  height: 68rpx;
  line-height: 66rpx;
  padding: 0 32rpx;
  border-radius: 34rpx;
  margin: 0 20rpx 20rpx 0;
}

/* ============ 说明 ============ */
.desc {
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(31, 58, 68, 0.08);
  padding: 34rpx 30rpx;
}

.desc__text {
  font-size: 27rpx;
  color: #3A4348;
  line-height: 1.85;
}

/* ============ 咨询引导 ============ */
.cta {
  margin: 40rpx 32rpx 0;
  padding: 42rpx 36rpx;
  border-radius: 24rpx;
  background: linear-gradient(150deg, #16292F 0%, #1F3A44 100%);
  box-shadow: 0 12rpx 32rpx rgba(31, 58, 68, 0.22);
  display: flex;
  flex-direction: column;
}

.cta__title {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.cta__desc {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.75);
}

.cta__btn {
  margin-top: 32rpx;
  height: 84rpx;
  border-radius: 42rpx;
  background: #FFFFFF;
  color: #16292F;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

/* ============ 用量计算入口 ============ */
.calcbar {
  margin: 0 32rpx 8rpx;
  padding: 24rpx 26rpx;
  border-radius: 16rpx;
  background: #1F3A44;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 8rpx 24rpx rgba(31, 58, 68, 0.2);
}

.calcbar__text {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 600;
  flex: 1;
}

.calcbar__arrow {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.75);
  flex: none;
  margin-left: 16rpx;
}

/* ============ 相关资质 ============ */
.certs {
  display: flex;
  flex-direction: column;
}

.cert {
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 24rpx rgba(31, 58, 68, 0.08);
  padding: 26rpx 28rpx;
  margin-bottom: 18rpx;
  display: flex;
  flex-direction: column;
}

.cert__title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1D2226;
  line-height: 1.5;
}

.cert__issuer {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #8A9298;
}

.card-hover {
  opacity: 0.88;
}

.bottom-space {
  height: 180rpx;
}

/* ============ 数据异常 ============ */
.missing {
  padding: 200rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.missing__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3A4348;
}

.missing__desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #8A9298;
}

.missing__btn {
  margin-top: 44rpx;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 56rpx;
  border-radius: 42rpx;
  background: #1F3A44;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
}

/* ============ 底部操作栏 ============ */
.actionbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  background: #FFFFFF;
  border-top: 1rpx solid #E2DDD3;
  padding-bottom: env(safe-area-inset-bottom);
}

.actionbar__inner {
  display: flex;
  align-items: center;
  height: 112rpx;
  padding: 0 24rpx;
}

.actionbar__side {
  width: 110rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.actionbar__side-text {
  font-size: 24rpx;
  color: #3A4348;
}

.actionbar__main {
  flex: 1;
  height: 84rpx;
  margin-left: 16rpx;
  border-radius: 42rpx;
  background: #1F3A44;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
}

/* ============ 系列不存在 ============ */
.nofound {
  padding: 160rpx 64rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.nofound__title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1D2226;
  text-align: center;
}

.nofound__desc {
  margin-top: 20rpx;
  font-size: 25rpx;
  color: #5C666B;
  line-height: 1.8;
  text-align: center;
}

.nofound__btn {
  margin-top: 48rpx;
  width: 100%;
  max-width: 480rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: #1F3A44;
  color: #FFFFFF;
  font-size: 29rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nofound__btn--ghost {
  margin-top: 20rpx;
  background: #FFFFFF;
  color: #1F3A44;
  border: 2rpx solid #1F3A44;
}