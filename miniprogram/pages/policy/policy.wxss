/**policy.wxss 政策背书**/
.page {
  background: #F5F7F6;
}

/* ============ 引言 ============ */
.banner {
  margin: 8rpx 32rpx 0;
  padding: 44rpx 36rpx;
  border-radius: 24rpx;
  background: linear-gradient(150deg, #0A4A37 0%, #0F6B4F 60%, #13795A 100%);
  box-shadow: 0 12rpx 32rpx rgba(15, 107, 79, 0.22);
  display: flex;
  flex-direction: column;
}

.banner__title {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.banner__desc {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.85;
}

/* ============ 落地要点 ============ */
.takes {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -10rpx;
}

.take {
  width: calc(50% - 20rpx);
  margin: 0 10rpx 20rpx;
  padding: 28rpx 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 24rpx rgba(15, 107, 79, 0.08);
  display: flex;
  flex-direction: column;
}

.take__title {
  font-size: 27rpx;
  font-weight: 700;
  color: #0F6B4F;
}

.take__desc {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #6B7B75;
  line-height: 1.7;
}

/* ============ 政策卡片 ============ */
.polies {
  display: flex;
  flex-direction: column;
}

.poly {
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 24rpx rgba(15, 107, 79, 0.08);
  padding: 30rpx 28rpx;
  margin-bottom: 20rpx;
  border-left: 8rpx solid #E3E9E6;
  display: flex;
  flex-direction: column;
}

/* 强制性 / 补贴类政策：更醒目的左侧色条 */
.poly.is-hot {
  border-left-color: #C2703E;
}

.poly__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.poly__name {
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
  color: #16211D;
  line-height: 1.5;
  padding-right: 16rpx;
}

.poly__tag {
  flex: none;
  font-size: 20rpx;
  color: #8A4A22;
  background: #FBF1EA;
  height: 38rpx;
  line-height: 38rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
}

.poly__issuer {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: #9AA8A2;
}

.poly__body {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #3D4A45;
  line-height: 1.85;
}

/* ============ 参考文献 ============ */
.ref {
  display: flex;
  align-items: flex-start;
  padding: 26rpx 28rpx;
  border-bottom: 1rpx solid #E3E9E6;
}

.ref:last-child {
  border-bottom: none;
}

.ref__no {
  width: 52rpx;
  flex: none;
  font-size: 24rpx;
  font-weight: 700;
  color: #0F6B4F;
}

.ref__body {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.ref__name {
  font-size: 25rpx;
  color: #16211D;
  line-height: 1.6;
}

.ref__url {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #0F6B4F;
  line-height: 1.5;
  word-break: break-all;
}

.card-hover {
  opacity: 0.9;
}

.note {
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 12rpx;
  background: #FDFAF2;
  border: 1rpx solid #F3E4C4;
}

.note__text {
  font-size: 21rpx;
  color: #8A6A24;
  line-height: 1.7;
}

/* ============ 咨询 ============ */
.cta {
  margin: 32rpx 32rpx 0;
  padding: 42rpx 36rpx;
  border-radius: 24rpx;
  background: linear-gradient(150deg, #0A4A37 0%, #0F6B4F 100%);
  box-shadow: 0 12rpx 32rpx rgba(15, 107, 79, 0.22);
  display: flex;
  flex-direction: column;
}

.cta__title {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.cta__desc {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.75);
  line-height: 1.6;
}

.cta__btn {
  margin-top: 28rpx;
  height: 84rpx;
  border-radius: 42rpx;
  background: #FFFFFF;
  color: #0A4A37;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.cta__btn--ghost {
  background: transparent;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  color: #FFFFFF;
  margin-top: 18rpx;
}

.bottom-space {
  height: 80rpx;
}
