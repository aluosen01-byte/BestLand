/**agreement.wxss —— 构建产物（由 agreement.less 编译而来）**/
.page {
  background: #FFFFFF;
}

.head {
  padding: 40rpx 44rpx 32rpx;
  border-bottom: 1rpx solid #D8D2C6;
  display: flex;
  flex-direction: column;
}

.head__title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1D2226;
  line-height: 1.4;
}

.head__meta {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #8A9298;
}

.body {
  padding: 8rpx 44rpx 0;
}

.clause {
  padding: 34rpx 0;
  border-bottom: 1rpx solid #D8D2C6;
}

.clause:last-child {
  border-bottom: none;
}

.clause__head {
  display: flex;
  align-items: baseline;
}

.clause__no {
  font-size: 26rpx;
  font-weight: 700;
  color: #1F3A44;
  margin-right: 16rpx;
  flex: none;
}

.clause__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1D2226;
}

.clause__p {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #3A4348;
  line-height: 1.9;
}

.foot {
  margin: 16rpx 44rpx 0;
  padding: 34rpx 30rpx;
  border-radius: 0;
  background: #F7F5F0;
  display: flex;
  flex-direction: column;
}

.foot__text {
  font-size: 24rpx;
  color: #5C666B;
  line-height: 1.8;
}

.foot__contact {
  margin-top: 14rpx;
  font-size: 25rpx;
  color: #1D2226;
  font-weight: 500;
}

.bottom-space {
  height: 80rpx;
}
