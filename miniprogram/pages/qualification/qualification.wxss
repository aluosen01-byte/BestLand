/**qualification.wxss —— 构建产物（由 qualification.less 编译而来）**/
.page {
  background: #F5F7F6;
  padding-bottom: 40rpx;
}

/* ============ 概览 ============ */
.banner {
  margin: 8rpx 32rpx 0;
  padding: 44rpx 36rpx 36rpx;
  border-radius: 24rpx;
  background: linear-gradient(150deg, #0A4A37 0%, #0F6B4F 60%, #13795A 100%);
  box-shadow: 0 12rpx 32rpx rgba(15, 107, 79, 0.22);
  display: flex;
  flex-direction: column;
}

.banner__title {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.banner__desc {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.78);
  line-height: 1.75;
}

.banner__stats {
  display: flex;
  align-items: center;
  margin-top: 36rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.18);
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat__num {
  font-size: 42rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.1;
}

.stat__label {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.66);
}

.stat__sep {
  width: 1rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.18);
}

/* ============ 分类 ============ */
.tabs {
  display: flex;
  padding: 36rpx 32rpx 8rpx;
}

.tab {
  flex: 1;
  height: 72rpx;
  line-height: 70rpx;
  text-align: center;
  font-size: 26rpx;
  color: #3D4A45;
  background: #FFFFFF;
  border: 1rpx solid #E3E9E6;
  border-radius: 36rpx;
  margin-right: 14rpx;
}

.tab:last-child {
  margin-right: 0;
}

.tab.is-on {
  background: #0F6B4F;
  border-color: #0F6B4F;
  color: #FFFFFF;
  font-weight: 600;
}

/* ============ 证书列表 ============ */
.list {
  padding: 24rpx 32rpx 0;
}

.cert {
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(15, 107, 79, 0.08);
  overflow: hidden;
  margin-bottom: 26rpx;
}

.cert__pic {
  position: relative;
  height: 380rpx;
  background: #F5F7F6;
  padding: 20rpx;
}

.cert__pages {
  position: absolute;
  right: 32rpx;
  bottom: 32rpx;
  font-size: 20rpx;
  color: #FFFFFF;
  background: rgba(22, 33, 29, 0.62);
  height: 40rpx;
  line-height: 40rpx;
  padding: 0 18rpx;
  border-radius: 20rpx;
}

.cert__body {
  padding: 28rpx 28rpx 30rpx;
  display: flex;
  flex-direction: column;
}

.cert__title {
  font-size: 29rpx;
  font-weight: 700;
  color: #16211D;
  line-height: 1.5;
}

.cert__meta {
  display: flex;
  margin-top: 12rpx;
}

.cert__meta-label {
  width: 76rpx;
  flex: none;
  font-size: 22rpx;
  color: #9AA8A2;
}

.cert__meta-value {
  flex: 1;
  font-size: 22rpx;
  color: #6B7B75;
  line-height: 1.6;
}

.cert__conclusion {
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: 12rpx;
  background: #F2F8F5;
}

.cert__conclusion-text {
  font-size: 23rpx;
  color: #0A4A37;
  font-weight: 500;
}

.cert__actions {
  display: flex;
  margin-top: 26rpx;
}

.cert__btn {
  flex: 1;
  height: 76rpx;
  border-radius: 38rpx;
  background: #0F6B4F;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  margin-right: 18rpx;
}

.cert__btn:last-child {
  margin-right: 0;
}

.cert__btn--ghost {
  background: #FFFFFF;
  color: #0F6B4F;
  border: 2rpx solid #0F6B4F;
}

.cert__nopic {
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: 12rpx;
  background: #FDFAF2;
  border: 1rpx solid #F3E4C4;
}

.cert__nopic-text {
  font-size: 22rpx;
  color: #8A6A24;
  line-height: 1.65;
}

.card-hover {
  opacity: 0.9;
}

/* ============ 说明 ============ */
.tips {
  margin: 8rpx 32rpx 0;
  padding: 32rpx 30rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #E3E9E6;
  display: flex;
  flex-direction: column;
}

.tips__title {
  font-size: 27rpx;
  font-weight: 700;
  color: #16211D;
  margin-bottom: 14rpx;
}

.tips__line {
  font-size: 23rpx;
  color: #6B7B75;
  line-height: 1.9;
}

/* ============ 咨询 ============ */
.cta {
  margin: 32rpx 32rpx 0;
  padding: 42rpx 36rpx;
  border-radius: 24rpx;
  background: linear-gradient(150deg, #0A4A37 0%, #0F6B4F 100%);
  display: flex;
  flex-direction: column;
}

.cta__title {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.cta__desc {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.75);
}

.cta__btn {
  margin-top: 32rpx;
  height: 84rpx;
  border-radius: 42rpx;
  background: #FFFFFF;
  color: #0A4A37;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.bottom-space {
  height: 60rpx;
}
