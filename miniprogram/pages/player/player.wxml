<!--player.wxml 视频播放（web-view 内嵌网页播放器）-->
<navigation-bar title="{{title}}" back="{{true}}" color="#16211D" background="#FFFFFF"></navigation-bar>

<!--
  为什么用 web-view：
  小程序里不能用代码直接打开外部网址，唯一能让用户「点一下就直接看」的方式
  就是 web-view 内嵌一个网页。内嵌页面只做一件事：加载 HTML5 <video> 播放器。

  ⚠️ 需要把 senluoflow.com 加入微信公众平台「业务域名」，
     否则 web-view 无法加载（下方会显示兜底提示）。
-->
<view class="page">
  <view class="stage">
    <web-view src="{{playerUrl}}" bindload="onViewLoad" binderror="onViewError"></web-view>
  </view>

  <view class="tip" wx:if="{{failed}}">
    <text class="tip__title">内嵌播放暂不可用</text>
    <text class="tip__text">
      内嵌网页需要把 senluoflow.com 加入微信公众平台「业务域名」。
      可先点下方「复制链接」到浏览器观看，或联系我们索取视频。
    </text>
  </view>

  <view class="bar">
    <view class="bar__btn bar__btn--ghost" bindtap="play" hover-class="btn-hover">重新加载</view>
    <view class="bar__btn bar__btn--solid" bindtap="copyUrl" hover-class="btn-hover">复制链接</view>
  </view>
</view>
