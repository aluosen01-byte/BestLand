/**videos.wxss 视频中心**/
@import "../../components/tab-bar/tab-bar.wxss";

.page {
  background: #F5F7F6;
}

/* ============ 头图 ============ */
.hero {
  padding: 36rpx 44rpx 40rpx;
  display: flex;
  flex-direction: column;
}

.hero__title {
  font-size: 44rpx;
  font-weight: 700;
  color: #16211D;
  letter-spacing: 1rpx;
}

.hero__desc {
  margin-top: 14rpx;
  font-size: 25rpx;
  color: #6B7B75;
}

.hero__tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 26rpx;
}

.hero__tag {
  font-size: 22rpx;
  color: #0F6B4F;
  background: #E6F2ED;
  height: 44rpx;
  line-height: 44rpx;
  padding: 0 22rpx;
  border-radius: 22rpx;
  margin: 0 16rpx 0 0;
}

/* ============ 头图外链提示 ============ */
.hero__note {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
}

.hero__note-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.92);
  line-height: 1.7;
}

/* ============ 当前选中（外链播放）============ */
.player {
  margin: 0 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(15, 107, 79, 0.08);
  overflow: hidden;
}

/* 9:16 竖版：容器按比例留高，配合 aspectFit 不裁切 */
.player__stage {
  position: relative;
  width: 100%;
  height: 1220rpx;
  background: #0A1712;
}

.player__meta {
  padding: 26rpx 28rpx 20rpx;
  display: flex;
  flex-direction: column;
}

.player__title {
  font-size: 32rpx;
  font-weight: 700;
  color: #16211D;
}

.player__sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6B7B75;
}

/* 外链地址展示：让用户知道链接长什么样 */
.player__url {
  margin: 0 28rpx;
  padding: 18rpx 22rpx;
  border-radius: 12rpx;
  background: #F5F7F6;
  border: 1rpx solid #E3E9E6;
}

.player__url-text {
  font-size: 21rpx;
  color: #0F6B4F;
  word-break: break-all;
  line-height: 1.5;
}

.player__actions {
  display: flex;
  margin: 24rpx 28rpx 0;
}

.player__btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  background: #0F6B4F;
  color: #FFFFFF;
  font-size: 29rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(15, 107, 79, 0.22);
}

/* 复制后的操作提示 */
.player__hint {
  margin: 18rpx 28rpx 30rpx;
  text-align: center;
}

.player__hint-text {
  font-size: 21rpx;
  color: #8A9691;
  line-height: 1.6;
}

/* ============ 视频网格 ============ */
.grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -10rpx;
}

.card {
  width: calc(50% - 20rpx);
  margin: 0 10rpx 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 24rpx rgba(15, 107, 79, 0.08);
  overflow: hidden;
  border: 2rpx solid transparent;
}

.card.is-on {
  border-color: #0F6B4F;
}

.card-hover {
  opacity: 0.88;
}

.card__pic {
  position: relative;
  height: 500rpx;
  background: #0A1712;
}

/* 复制徽标：明确表达「点了是复制」，不暗示可播放 */
.card__copy {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  height: 48rpx;
  padding: 0 20rpx;
  border-radius: 24rpx;
  background: rgba(15, 107, 79, 0.92);
  display: flex;
  align-items: center;
  justify-content: center;
}

.card__copy-text {
  font-size: 21rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.card__time {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  font-size: 20rpx;
  color: #FFFFFF;
  background: rgba(0, 0, 0, 0.55);
  height: 34rpx;
  line-height: 34rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
}

.card__body {
  padding: 18rpx 20rpx 22rpx;
  display: flex;
  flex-direction: column;
}

.card__title {
  font-size: 26rpx;
  font-weight: 600;
  color: #16211D;
  line-height: 1.45;
}

.card__sub {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #9AA8A2;
  line-height: 1.5;
}

/* ============ 咨询 ============ */
.cta {
  margin: 8rpx 32rpx 0;
  padding: 42rpx 36rpx;
  border-radius: 24rpx;
  background: linear-gradient(150deg, #0A4A37 0%, #0F6B4F 100%);
  box-shadow: 0 12rpx 32rpx rgba(15, 107, 79, 0.22);
  display: flex;
  flex-direction: column;
}

.cta__title {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.cta__desc {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.75);
}

.cta__btn {
  margin-top: 32rpx;
  height: 84rpx;
  border-radius: 42rpx;
  background: #FFFFFF;
  color: #0A4A37;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.bottom-space {
  height: 20rpx;
}
