/**products.wxss —— 构建产物（由 products.less 编译而来）**/
@import "../../components/tab-bar/tab-bar.wxss";

.page {
  background: #F7F5F0;
}

/* ============ 筛选区 ============ */
.toolbar {
  position: sticky;
  top: 0;
  z-index: 20;
  background: #FFFFFF;
  padding: 20rpx 32rpx 4rpx;
  border-bottom: 1rpx solid #E2DDD3;
}

.search {
  display: flex;
  align-items: center;
  height: 76rpx;
  background: #F7F5F0;
  border-radius: 38rpx;
  padding: 0 26rpx;
}

.search__icon {
  font-size: 34rpx;
  color: #8A9298;
  margin-right: 12rpx;
}

.search__input {
  flex: 1;
  font-size: 26rpx;
  color: #1D2226;
}

.search__ph {
  color: #8A9298;
  font-size: 25rpx;
}

.search__clear {
  font-size: 26rpx;
  color: #8A9298;
  padding: 0 4rpx;
}

.chips {
  width: 100%;
  white-space: nowrap;
  margin-top: 20rpx;
}

.chips__row {
  display: flex;
  padding-bottom: 20rpx;
}

.chip {
  flex: none;
  height: 60rpx;
  line-height: 58rpx;
  padding: 0 28rpx;
  border-radius: 30rpx;
  font-size: 25rpx;
  color: #3A4348;
  background: #F7F5F0;
  border: 1rpx solid #E2DDD3;
  margin-right: 16rpx;
}

.chip.is-on {
  background: #1F3A44;
  border-color: #1F3A44;
  color: #FFFFFF;
  font-weight: 600;
}

/* ============ 用量计算入口 ============ */
.calcbar {
  margin: 16rpx 32rpx 0;
  padding: 24rpx 26rpx;
  border-radius: 16rpx;
  background: #1F3A44;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 8rpx 24rpx rgba(31, 58, 68, 0.2);
}

.calcbar__text {
  font-size: 25rpx;
  color: #FFFFFF;
  font-weight: 600;
  flex: 1;
}

.calcbar__arrow {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.75);
  flex: none;
  margin-left: 16rpx;
}

/* ============ 统计条 ============ */
.countbar {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 26rpx 32rpx 6rpx;
}

.countbar__text {
  font-size: 24rpx;
  color: #5C666B;
}

.countbar__hint {
  font-size: 22rpx;
  color: #8A9298;
}

/* ============ 系列列表 ============ */
.list {
  padding: 20rpx 32rpx 0;
}

.item {
  display: flex;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(31, 58, 68, 0.08);
  overflow: hidden;
  margin-bottom: 24rpx;
}

.item__pic {
  position: relative;
  width: 240rpx;
  height: 260rpx;
  flex: none;
  background: #F2F5F5;
}

.item__badge {
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  font-size: 19rpx;
  font-weight: 700;
  color: #FFFFFF;
  background: #1F3A44;
  height: 34rpx;
  line-height: 34rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
}

.item__badge.is-accent {
  background: #F0A22E;
}

.item__body {
  flex: 1;
  padding: 24rpx 24rpx 22rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.item__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item__name {
  font-size: 31rpx;
  font-weight: 700;
  color: #1D2226;
}

.item__arrow {
  font-size: 34rpx;
  color: #8A9298;
  line-height: 1;
}

.item__tagline {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #5C666B;
}

.item__tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
  max-height: 92rpx;
  overflow: hidden;
}

.item__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 14rpx;
}

.item__count {
  font-size: 22rpx;
  color: #8A9298;
}

.item__pending {
  font-size: 20rpx;
  color: #C97A12;
  background: #FDF6E7;
  height: 34rpx;
  line-height: 34rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
}

.card-hover {
  opacity: 0.88;
}

/* ============ 空状态 ============ */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 60rpx;
}

.empty__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #3A4348;
}

.empty__desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #8A9298;
  text-align: center;
}

.empty__btn {
  margin-top: 40rpx;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 48rpx;
  border-radius: 40rpx;
  background: #1F3A44;
  color: #FFFFFF;
  font-size: 27rpx;
  font-weight: 600;
}

/* ============ 咨询引导 ============ */
.help {
  margin: 24rpx 32rpx 0;
  padding: 40rpx 36rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  border: 2rpx dashed #E8EDEE;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.help__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1D2226;
}

.help__desc {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #5C666B;
  line-height: 1.6;
  text-align: center;
}

.help__btn {
  margin-top: 32rpx;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 64rpx;
  border-radius: 42rpx;
  background: #1F3A44;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
}

/* ============ 悬浮留言 ============ */
.fab {
  position: fixed;
  right: 28rpx;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  z-index: 30;
  height: 72rpx;
  padding: 0 30rpx;
  border-radius: 36rpx;
  background: rgba(31, 58, 68, 0.94);
  box-shadow: 0 8rpx 24rpx rgba(31, 58, 68, 0.3);
  display: flex;
  align-items: center;
}

.fab__text {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 600;
}
