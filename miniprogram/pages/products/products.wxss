/**products.wxss —— 构建产物（由 products.less 编译而来）**/
@import "../../components/tab-bar/tab-bar.wxss";

.page {
  background: #F5F7F6;
}

/* ============ 筛选区 ============ */
.toolbar {
  position: sticky;
  top: 0;
  z-index: 20;
  background: #FFFFFF;
  padding: 20rpx 32rpx 4rpx;
  border-bottom: 1rpx solid #E3E9E6;
}

.search {
  display: flex;
  align-items: center;
  height: 76rpx;
  background: #F5F7F6;
  border-radius: 38rpx;
  padding: 0 26rpx;
}

.search__icon {
  font-size: 34rpx;
  color: #9AA8A2;
  margin-right: 12rpx;
}

.search__input {
  flex: 1;
  font-size: 26rpx;
  color: #16211D;
}

.search__ph {
  color: #9AA8A2;
  font-size: 25rpx;
}

.search__clear {
  font-size: 26rpx;
  color: #9AA8A2;
  padding: 0 4rpx;
}

.chips {
  width: 100%;
  white-space: nowrap;
  margin-top: 20rpx;
}

.chips__row {
  display: flex;
  padding-bottom: 20rpx;
}

.chip {
  flex: none;
  height: 60rpx;
  line-height: 58rpx;
  padding: 0 28rpx;
  border-radius: 30rpx;
  font-size: 25rpx;
  color: #3D4A45;
  background: #F5F7F6;
  border: 1rpx solid #E3E9E6;
  margin-right: 16rpx;
}

.chip.is-on {
  background: #0F6B4F;
  border-color: #0F6B4F;
  color: #FFFFFF;
  font-weight: 600;
}

/* ============ 统计条 ============ */
.countbar {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 26rpx 32rpx 6rpx;
}

.countbar__text {
  font-size: 24rpx;
  color: #6B7B75;
}

.countbar__hint {
  font-size: 22rpx;
  color: #9AA8A2;
}

/* ============ 系列列表 ============ */
.list {
  padding: 20rpx 32rpx 0;
}

.item {
  display: flex;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(15, 107, 79, 0.08);
  overflow: hidden;
  margin-bottom: 24rpx;
}

.item__pic {
  position: relative;
  width: 240rpx;
  height: 260rpx;
  flex: none;
  background: #F2F8F5;
}

.item__badge {
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  font-size: 19rpx;
  font-weight: 700;
  color: #FFFFFF;
  background: #0F6B4F;
  height: 34rpx;
  line-height: 34rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
}

.item__badge.is-accent {
  background: #C2703E;
}

.item__body {
  flex: 1;
  padding: 24rpx 24rpx 22rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.item__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item__name {
  font-size: 31rpx;
  font-weight: 700;
  color: #16211D;
}

.item__arrow {
  font-size: 34rpx;
  color: #9AA8A2;
  line-height: 1;
}

.item__tagline {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #6B7B75;
}

.item__tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
  max-height: 92rpx;
  overflow: hidden;
}

.item__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 14rpx;
}

.item__count {
  font-size: 22rpx;
  color: #9AA8A2;
}

.item__pending {
  font-size: 20rpx;
  color: #D98A1F;
  background: #FDF6E7;
  height: 34rpx;
  line-height: 34rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
}

.card-hover {
  opacity: 0.88;
}

/* ============ 空状态 ============ */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 60rpx;
}

.empty__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #3D4A45;
}

.empty__desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #9AA8A2;
  text-align: center;
}

.empty__btn {
  margin-top: 40rpx;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 48rpx;
  border-radius: 40rpx;
  background: #0F6B4F;
  color: #FFFFFF;
  font-size: 27rpx;
  font-weight: 600;
}

/* ============ 咨询引导 ============ */
.help {
  margin: 24rpx 32rpx 0;
  padding: 40rpx 36rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  border: 2rpx dashed #E6F2ED;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.help__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #16211D;
}

.help__desc {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #6B7B75;
  line-height: 1.6;
  text-align: center;
}

.help__btn {
  margin-top: 32rpx;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 64rpx;
  border-radius: 42rpx;
  background: #0F6B4F;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
}

/* ============ 悬浮留言 ============ */
.fab {
  position: fixed;
  right: 28rpx;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  z-index: 30;
  height: 72rpx;
  padding: 0 30rpx;
  border-radius: 36rpx;
  background: rgba(15, 107, 79, 0.94);
  box-shadow: 0 8rpx 24rpx rgba(15, 107, 79, 0.3);
  display: flex;
  align-items: center;
}

.fab__text {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 600;
}
