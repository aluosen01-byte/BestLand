<!--contact.wxml 咨询与留言-->
<navigation-bar title="咨询与留言" back="{{false}}" color="#16211D" background="#FFFFFF"></navigation-bar>

<view class="page">
  <!-- ============ 直接联系我们 ============ -->
  <view class="hero">
    <text class="hero__title">聊聊你的项目</text>
    <text class="hero__desc">工程采购、经销代理、家装选型，都可以直接找我们</text>

    <view class="hero__actions">
      <view class="hero__btn hero__btn--solid" bindtap="callPhone" hover-class="btn-hover">
        <text class="hero__btn-label">电话咨询</text>
        <text class="hero__btn-sub">{{site.phoneText}}</text>
      </view>
      <view class="hero__btn hero__btn--ghost" bindtap="copyPhone" hover-class="btn-hover">
        <text class="hero__btn-label">复制号码</text>
        <text class="hero__btn-sub">方便稍后联系</text>
      </view>
    </view>
  </view>

  <!-- ============ 留言表单 ============ -->
  <view class="section">
    <view class="section-head">
      <view>
        <view class="section-title">在线留言</view>
        <view class="section-sub">带 <text class="req">*</text> 为必填项</view>
      </view>
      <view class="section-more" bindtap="goMessages" hover-class="btn-hover">我的留言<text class="arrow">›</text></view>
    </view>

    <view class="card form">
      <!-- 称呼 -->
      <view class="field">
        <text class="field__label">称呼<text class="req">*</text></text>
        <input
          class="field__input"
          value="{{form.name}}"
          data-key="name"
          bindinput="onInput"
          placeholder="怎么称呼你，如 王先生"
          placeholder-class="ph"
          maxlength="20"
        />
      </view>

      <!-- 手机号 -->
      <view class="field">
        <text class="field__label">手机号<text class="req">*</text></text>
        <input
          class="field__input"
          value="{{form.phone}}"
          data-key="phone"
          bindinput="onInput"
          type="number"
          placeholder="便于我们回电"
          placeholder-class="ph"
          maxlength="11"
        />
      </view>

      <!-- 公司 -->
      <view class="field">
        <text class="field__label">公司 / 项目</text>
        <input
          class="field__input"
          value="{{form.company}}"
          data-key="company"
          bindinput="onInput"
          placeholder="选填，如 XX 建筑装饰"
          placeholder-class="ph"
          maxlength="40"
        />
      </view>

      <!-- 城市 -->
      <view class="field">
        <text class="field__label">所在城市</text>
        <input
          class="field__input"
          value="{{form.city}}"
          data-key="city"
          bindinput="onInput"
          placeholder="选填，便于就近安排服务"
          placeholder-class="ph"
          maxlength="20"
        />
      </view>

      <!-- 咨询类型 -->
      <view class="field field--block">
        <text class="field__label">咨询类型</text>
        <view class="types">
          <view
            class="type {{form.type === item ? 'is-on' : ''}}"
            wx:for="{{types}}"
            wx:key="*this"
            bindtap="selectType"
            data-type="{{item}}"
          >{{item}}</view>
        </view>
      </view>

      <!-- 感兴趣系列 -->
      <view class="field field--block">
        <text class="field__label">感兴趣的产品</text>
        <picker mode="selector" range="{{interestOptions}}" value="{{interestIndex}}" bindchange="onInterest">
          <view class="picker">
            <text class="picker__text {{interestIndex === 0 ? 'is-ph' : ''}}">{{interestOptions[interestIndex]}}</text>
            <text class="picker__arrow">▾</text>
          </view>
        </picker>
      </view>

      <!-- 留言内容 -->
      <view class="field field--block field--last">
        <text class="field__label">需求说明</text>
        <textarea
          class="field__textarea"
          value="{{form.message}}"
          data-key="message"
          bindinput="onInput"
          placeholder="例如：厂房内墙翻新，约 3000 ㎡，基层有起砂，想了解推荐方案和用量"
          placeholder-class="ph"
          maxlength="300"
          auto-height
        />
        <view class="counter">{{form.message.length}}/300</view>
      </view>
    </view>

    <!-- 提交 -->
    <view class="submit {{submitting ? 'is-disabled' : ''}}" bindtap="submit" hover-class="btn-hover">
      {{submitting ? '提交中…' : '提交留言'}}
    </view>

    <view class="agree" bindtap="toggleAgree">
      <view class="agree__box {{agreed ? 'is-on' : ''}}">{{agreed ? '✓' : ''}}</view>
      <text class="agree__text">我已阅读并同意</text>
      <text class="agree__link" catchtap="goAgreement">《免责声明与信息使用说明》</text>
    </view>

    <view class="notice" wx:if="{{showLocalNotice}}">
      <text class="notice__text">
        当前未启用云端接收，留言会保存在你的手机里。你可以拨打 {{site.phoneText}} 直接联系我们，或在「我的留言」中查看已提交内容。
      </text>
    </view>
  </view>

  <!-- ============ 联系方式 ============ -->
  <view class="section section--tight">
    <view class="section-head">
      <view class="section-title">联系方式</view>
    </view>

    <view class="card">
      <view class="contact contact--first">
        <text class="contact__label">业务对接</text>
        <view class="contact__right">
          <text class="contact__value">{{site.contactName}}</text>
        </view>
      </view>

      <view class="contact" bindtap="callPhone" hover-class="card-hover">
        <text class="contact__label">客服电话</text>
        <view class="contact__right">
          <text class="contact__value contact__value--link">{{site.phoneText}}</text>
          <text class="contact__arrow">›</text>
        </view>
      </view>

      <view class="contact" bindtap="copyEmail" hover-class="card-hover" wx:if="{{site.email}}">
        <text class="contact__label">邮箱</text>
        <view class="contact__right">
          <text class="contact__value">{{site.email}}</text>
          <text class="contact__arrow">›</text>
        </view>
      </view>

      <view class="contact" bindtap="openWebsite" hover-class="card-hover" wx:if="{{site.website}}">
        <text class="contact__label">官方网站</text>
        <view class="contact__right">
          <text class="contact__value contact__value--link">{{site.websiteText}}</text>
          <text class="contact__arrow">›</text>
        </view>
      </view>

      <view class="contact" bindtap="copyAddress" hover-class="card-hover">
        <text class="contact__label">公司地址</text>
        <view class="contact__right">
          <text class="contact__value">{{site.address}}</text>
          <text class="contact__arrow">›</text>
        </view>
      </view>

      <view class="contact contact--last">
        <text class="contact__label">办公时间</text>
        <view class="contact__right">
          <text class="contact__value">{{site.workTime}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ============ 常见问题 ============ -->
  <view class="section section--tight">
    <view class="section-head">
      <view class="section-title">常见问题</view>
    </view>

    <view class="card">
      <view
        class="faq"
        wx:for="{{faqs}}"
        wx:key="q"
        bindtap="toggleFaq"
        data-index="{{index}}"
      >
        <view class="faq__head">
          <text class="faq__q">{{item.q}}</text>
          <text class="faq__icon">{{item.open ? '−' : '+'}}</text>
        </view>
        <text class="faq__a" wx:if="{{item.open}}">{{item.a}}</text>
      </view>
    </view>
  </view>

  <view class="bottom-space"></view>
  <view class="pad-tabbar"></view>
</view>

<tab-bar active="contact" />
