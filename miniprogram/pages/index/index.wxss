/**index.wxss —— 构建产物（由 index.less 编译而来）**/
@import "../../components/tab-bar/tab-bar.wxss";

.page {
  background: #F7F5F0;
}

/* ============ 品牌首屏 ============ */
.hero {
  position: relative;
  margin-top: -1px;
  padding: 0 40rpx 120rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #D8D2C6;
  overflow: hidden;
}

/* ---------- 封面斜线（v47 封面构图）----------
   一个斜切容器内放三条竖条，天然平行；
   比旋转方块更可控，不会溢出盖住文字。
   倾斜 5deg，容器占右侧 30%，文字区限制在 62% */
.hero__deco {
  position: absolute;
  top: 0;
  bottom: 0;
  right: 0;
  width: 30%;
  transform: skewX(-5deg);
  transform-origin: right center;
  pointer-events: none;
  z-index: 0;
}

.hero__deco-line,
.hero__deco-band,
.hero__deco-block {
  position: absolute;
  top: 0;
  bottom: 0;
}

.hero__deco-line {
  left: 0;
  width: 8rpx;
  background: #F4F1EA;
}

.hero__deco-band {
  left: 24rpx;
  width: 72rpx;
  background: #1F3A44;
}

.hero__deco-block {
  left: 110rpx;
  right: 0;
  background: #F0A22E;
}

/* 宣传册封面语言：英文小标 + 口号 + 特性行 */
.hero__kicker {
  position: relative;
  display: block;
  padding-top: 36rpx;
  font-family: Arial, "Helvetica Neue", sans-serif;
  font-size: 21rpx;
  letter-spacing: 3rpx;
  color: #2F6FB2;
}

.hero__motto {
  position: relative;
  display: block;
  margin-top: 40rpx;
  font-size: 52rpx;
  font-weight: 700;
  color: #F0A22E;
  letter-spacing: 2rpx;
  line-height: 1.25;
  max-width: 64%;
}

.hero__motto-en {
  position: relative;
  display: block;
  margin-top: 10rpx;
  font-family: Arial, "Helvetica Neue", sans-serif;
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: #5C666B;
  max-width: 64%;
}

.hero__line {
  position: relative;
  display: block;
  margin-top: 28rpx;
  font-size: 24rpx;
  color: #1D2226;
  line-height: 1.7;
  max-width: 64%;
}
.hero__brand {
  position: relative;
  display: flex;
  align-items: center;
  padding-top: 28rpx;
}

/* 品牌组合标识（v47 宣传册第 3 页，480×211 透明 PNG） */
.hero__logo {
  width: 300rpx;
  height: 132rpx;
}

.hero__tags {
  position: relative;
  display: flex;
  flex-wrap: wrap;
  margin-top: 28rpx;
  max-width: 64%;
}

.hero__tag {
  font-size: 21rpx;
  color: #1F3A44;
  background: #FFFFFF;
  border: 1rpx solid #D8D2C6;
  height: 44rpx;
  line-height: 42rpx;
  padding: 0 18rpx;
  border-radius: 0;
  margin: 0 12rpx 12rpx 0;
}

.hero__actions {
  position: relative;
  display: flex;
  margin-top: 36rpx;
  max-width: 64%;
}

.hero__btn {
  flex: 1;
  height: 88rpx;
  border-radius: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
}

.hero__btn--solid {
  background: #1F3A44;
  color: #FFFFFF;
  margin-right: 16rpx;
}

.hero__btn--ghost {
  background: #FFFFFF;
  border: 1rpx solid #1F3A44;
  color: #1F3A44;
}

/* ============ 核心卖点 ============ */
/* 六大优势：白色圆角卡片两列（版式与配色对齐永耐 .adv-cell） */
.features {
  display: flex;
  flex-wrap: wrap;
  margin-top: 28rpx;
}

.feature {
  width: calc((100% - 16rpx) / 2);
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  padding: 26rpx 24rpx;
  box-sizing: border-box;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 58, 68, 0.04);
  display: flex;
  flex-direction: column;
}

.feature:nth-child(2n) {
  margin-right: 0;
}

.feature__no {
  display: block;
  font-family: Arial, "Helvetica Neue", sans-serif;
  font-size: 24rpx;
  font-weight: 800;
  color: #E0C99A;
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.feature__title {
  margin-top: 10rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: #1F3A44;
  line-height: 1.4;
}

.feature__desc {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #6E777C;
  line-height: 1.65;
}

/* ============ 用量计算入口 ============ */
.calc {
  margin: 8rpx 32rpx 0;
  padding: 32rpx 30rpx;
  border-radius: 0;
  background: linear-gradient(150deg, #16292F 0%, #1F3A44 100%);
  box-shadow: none;
  display: flex;
  align-items: center;
}

.calc__left {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
  padding-right: 20rpx;
}

.calc__badge {
  align-self: flex-start;
  font-size: 19rpx;
  font-weight: 700;
  color: #16292F;
  background: #FFFFFF;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 12rpx;
  border-radius: 0;
  margin-bottom: 12rpx;
}

.calc__title {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.calc__desc {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
  line-height: 1.6;
}

.calc__right {
  flex: none;
}

.calc__arrow {
  font-size: 44rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* ============ 系列横滑 ============ */
.series-scroll {
  width: 100%;
  white-space: nowrap;
}

.series-row {
  display: flex;
  padding-bottom: 8rpx;
}

.series-card {
  flex: none;
  width: 320rpx;
  margin-right: 24rpx;
  background: #FFFFFF;
  border-radius: 0;
  box-shadow: none;
  overflow: hidden;
}

.series-card:last-child {
  margin-right: 0;
}

.card-hover {
  opacity: 0.88;
}

.series-card__pic {
  position: relative;
  height: 240rpx;
  background: #F2F5F5;
}

.series-card__badge {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #FFFFFF;
  background: #1F3A44;
  height: 38rpx;
  line-height: 38rpx;
  padding: 0 14rpx;
  border-radius: 0;
  letter-spacing: 1rpx;
}

.series-card__badge.is-accent {
  background: #F0A22E;
}

.series-card__body {
  padding: 20rpx 22rpx 26rpx;
  display: flex;
  flex-direction: column;
}

.series-card__name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D2226;
}

.series-card__tag {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #5C666B;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ============ 品牌实力 ============ */
.values {
  background: #FFFFFF;
  border-radius: 0;
  box-shadow: none;
  padding: 8rpx 28rpx;
}

.value {
  display: flex;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #D8D2C6;
}

.value:last-child {
  border-bottom: none;
}

.value__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #1F3A44;
  margin: 14rpx 20rpx 0 0;
  flex: none;
}

.value__text {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.value__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D2226;
}

.value__desc {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #5C666B;
  line-height: 1.65;
}

/* ============ 证书横滑 ============ */
.cert-scroll {
  width: 100%;
  white-space: nowrap;
}

.cert-row {
  display: flex;
  padding-bottom: 8rpx;
}

.cert-card {
  flex: none;
  width: 260rpx;
  margin-right: 24rpx;
  background: #FFFFFF;
  border-radius: 0;
  box-shadow: none;
  overflow: hidden;
}

.cert-card:last-child {
  margin-right: 0;
}

.cert-card__pic {
  height: 300rpx;
  background: #FFFFFF;
}

.cert-card__title {
  display: block;
  padding: 16rpx 18rpx 22rpx;
  font-size: 22rpx;
  color: #3A4348;
  line-height: 1.5;
  white-space: normal;
}

/* ============ 服务场景 ============ */
.scenes {
  display: flex;
  flex-wrap: wrap;
}

.scene {
  font-size: 26rpx;
  color: #3A4348;
  background: #FFFFFF;
  border: 1rpx solid #D8D2C6;
  height: 68rpx;
  line-height: 66rpx;
  padding: 0 30rpx;
  border-radius: 0;
  margin: 0 20rpx 20rpx 0;
}

/* ============ 联系我们 ============ */
.cta {
  margin: 8rpx 32rpx 0;
  padding: 44rpx 36rpx;
  border-radius: 0;
  background: linear-gradient(150deg, #16292F 0%, #1F3A44 100%);
  box-shadow: none;
}

.cta__body {
  display: flex;
  flex-direction: column;
}

.cta__title {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.cta__desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
  line-height: 1.6;
}

.cta__actions {
  display: flex;
  margin-top: 36rpx;
}

.cta__btn {
  flex: 1;
  height: 84rpx;
  border-radius: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.cta__btn--solid {
  background: #FFFFFF;
  color: #16292F;
  margin-right: 18rpx;
}

.cta__btn--ghost {
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  color: #FFFFFF;
}

/* ============ 招商加盟 ============ */
.biz {
  margin: 32rpx 32rpx 0;
  padding: 40rpx 34rpx;
  border-radius: 0;
  background: #FFFFFF;
  border: 2rpx solid #E8EDEE;
  box-shadow: none;
  display: flex;
  flex-direction: column;
}

.biz__head {
  display: flex;
  align-items: center;
}

.biz__badge {
  font-size: 20rpx;
  font-weight: 700;
  color: #FFFFFF;
  background: #F0A22E;
  height: 38rpx;
  line-height: 38rpx;
  padding: 0 14rpx;
  border-radius: 0;
  margin-right: 16rpx;
}

.biz__title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1D2226;
}

.biz__desc {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #5C666B;
  line-height: 1.8;
}

.biz__points {
  display: flex;
  flex-wrap: wrap;
  margin-top: 22rpx;
}

.biz__point {
  font-size: 22rpx;
  color: #1F3A44;
  background: #E8EDEE;
  height: 44rpx;
  line-height: 44rpx;
  padding: 0 20rpx;
  border-radius: 0;
  margin: 0 14rpx 14rpx 0;
}

.biz__actions {
  display: flex;
  margin-top: 26rpx;
}

.biz__btn {
  flex: 1;
  height: 82rpx;
  border-radius: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  font-weight: 600;
}

.biz__btn--solid {
  background: #1F3A44;
  color: #FFFFFF;
  margin-right: 18rpx;
}

.biz__btn--ghost {
  background: #FFFFFF;
  color: #1F3A44;
  border: 2rpx solid #1F3A44;
}

/* ============ 页脚 ============ */
.footer {
  margin-top: 56rpx;
  padding: 48rpx 48rpx 40rpx;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-top: 1rpx solid #D8D2C6;
}

.footer__brand {
  font-size: 26rpx;
  font-weight: 600;
  color: #3A4348;
}

.footer__line {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #8A9298;
  text-align: center;
}

.footer__links {
  display: flex;
  align-items: center;
  margin-top: 26rpx;
}

.footer__link {
  font-size: 22rpx;
  color: #1F3A44;
}

.footer__dot {
  font-size: 22rpx;
  color: #8A9298;
  margin: 0 14rpx;
}

.footer__copy {
  margin-top: 22rpx;
  font-size: 20rpx;
  color: #8A9298;
}

/* ============================================================
   首页两组数据模块：厂房产量 / 快捷入口
   同一套卡片版式 —— 单行四格、圆角白卡、轻阴影、格间细线
   ============================================================ */

/* 卡片公共外观 */
.stats,
.quick {
  display: flex;
  position: relative;
  z-index: 3;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 58, 68, 0.07);
  overflow: hidden;
}

/* ---------- 厂房与产量：上浮叠在首屏下沿 ---------- */
.statwrap {
  padding: 0 40rpx;
  margin-bottom: 40rpx;
}

.stats {
  margin-top: -64rpx;
  padding: 30rpx 6rpx;
}

.stat {
  flex: 1;
  text-align: center;
  position: relative;
}

/* 格间竖线（首格无） */
.stat + .stat::before {
  content: '';
  position: absolute;
  left: 0;
  top: 12rpx;
  bottom: 12rpx;
  width: 1rpx;
  background: #EDEAE3;
}

.stat__value {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.stat__num {
  font-family: Arial, "Helvetica Neue", sans-serif;
  font-size: 40rpx;
  font-weight: 800;
  color: #1F3A44;
  letter-spacing: -0.5rpx;
  line-height: 1.2;
}

.stat__unit {
  margin-left: 3rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #A7B0B5;
}

.stat__label {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #8C979D;
  letter-spacing: 0.5rpx;
}

/* ---------- 快捷入口：单行四格 + 线性图标 ---------- */
.quickwrap {
  padding: 0 40rpx;
  margin-bottom: 56rpx;
}

.quick {
  padding: 28rpx 6rpx;
}

.quick__cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 6rpx 0;
}

.quick__icon {
  width: 56rpx;
  height: 56rpx;
}

.quick__text {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #43535A;
  letter-spacing: 0.5rpx;
}
