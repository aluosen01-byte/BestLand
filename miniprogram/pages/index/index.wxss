/**index.wxss —— 构建产物（由 index.less 编译而来）**/
@import "../../components/tab-bar/tab-bar.wxss";

.page {
  background: #F7F5F0;
}

/* ============ 品牌首屏 ============ */
.hero {
  position: relative;
  margin-top: -1px;
  padding: 0 48rpx 64rpx;
  background: linear-gradient(165deg, #16292F 0%, #1F3A44 52%, #2A5566 100%);
  overflow: hidden;
}

.hero__glow {
  position: absolute;
  right: -160rpx;
  top: -180rpx;
  width: 560rpx;
  height: 560rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.16) 0%, rgba(255, 255, 255, 0) 68%);
}

/* 宣传册封面语言：英文小标 + 口号 + 特性行 */
.hero__kicker {
  position: relative;
  display: block;
  padding-top: 34rpx;
  font-family: Arial, "Helvetica Neue", sans-serif;
  font-size: 21rpx;
  letter-spacing: 3rpx;
  color: #F0A22E;
}

.hero__motto {
  position: relative;
  display: block;
  margin-top: 30rpx;
  font-size: 46rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 2rpx;
  line-height: 1.3;
}

.hero__motto-en {
  position: relative;
  display: block;
  margin-top: 10rpx;
  font-family: Arial, "Helvetica Neue", sans-serif;
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: rgba(240, 162, 46, 0.92);
}

.hero__line {
  position: relative;
  display: block;
  margin-top: 26rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
  line-height: 1.7;
}
.hero__brand {
  position: relative;
  display: flex;
  align-items: center;
  padding-top: 34rpx;
}

.hero__mark {
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.14);
  border: 2rpx solid rgba(255, 255, 255, 0.34);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.hero__mark-text {
  font-size: 44rpx;
  color: #FFFFFF;
  font-weight: 700;
}

.hero__brand-text {
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
}

.hero__brand-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 6rpx;
}

.hero__brand-tag {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.6);
  letter-spacing: 4rpx;
}

.hero__title {
  position: relative;
  display: block;
  margin-top: 56rpx;
  font-size: 52rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.34;
  letter-spacing: 2rpx;
}

.hero__desc {
  position: relative;
  display: block;
  margin-top: 20rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.78);
  line-height: 1.7;
}

.hero__tags {
  position: relative;
  display: flex;
  flex-wrap: wrap;
  margin-top: 32rpx;
}

.hero__tag {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.92);
  background: rgba(255, 255, 255, 0.13);
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  height: 44rpx;
  line-height: 42rpx;
  padding: 0 20rpx;
  border-radius: 22rpx;
  margin: 0 16rpx 0 0;
}

.hero__actions {
  position: relative;
  display: flex;
  margin-top: 48rpx;
}

.hero__btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
}

.hero__btn--solid {
  background: #FFFFFF;
  color: #16292F;
  margin-right: 20rpx;
}

.hero__btn--ghost {
  border: 2rpx solid rgba(255, 255, 255, 0.55);
  color: #FFFFFF;
}

/* ============ 核心卖点 ============ */
.features {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -10rpx;
}

/* 宣传册第 4 页：橙色编号 + 白卡片，两列 */
.feature {
  width: 50%;
  padding: 0 10rpx 20rpx;
  display: flex;
  flex-direction: column;
}

.feature__no {
  font-family: Arial, "Helvetica Neue", sans-serif;
  font-size: 42rpx;
  font-weight: 700;
  color: #F0A22E;
  line-height: 1;
}

.feature__title {
  margin-top: 14rpx;
  font-size: 29rpx;
  font-weight: 700;
  color: #1F3A44;
  letter-spacing: 0.5rpx;
}

.feature__desc {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #5C666B;
  line-height: 1.65;
}

/* ============ 用量计算入口 ============ */
.calc {
  margin: 8rpx 32rpx 0;
  padding: 32rpx 30rpx;
  border-radius: 24rpx;
  background: linear-gradient(150deg, #16292F 0%, #1F3A44 100%);
  box-shadow: 0 12rpx 32rpx rgba(31, 58, 68, 0.22);
  display: flex;
  align-items: center;
}

.calc__left {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
  padding-right: 20rpx;
}

.calc__badge {
  align-self: flex-start;
  font-size: 19rpx;
  font-weight: 700;
  color: #16292F;
  background: #FFFFFF;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 12rpx;
  border-radius: 6rpx;
  margin-bottom: 12rpx;
}

.calc__title {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.calc__desc {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
  line-height: 1.6;
}

.calc__right {
  flex: none;
}

.calc__arrow {
  font-size: 44rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* ============ 系列横滑 ============ */
.series-scroll {
  width: 100%;
  white-space: nowrap;
}

.series-row {
  display: flex;
  padding-bottom: 8rpx;
}

.series-card {
  flex: none;
  width: 320rpx;
  margin-right: 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(31, 58, 68, 0.08);
  overflow: hidden;
}

.series-card:last-child {
  margin-right: 0;
}

.card-hover {
  opacity: 0.88;
}

.series-card__pic {
  position: relative;
  height: 240rpx;
  background: #F2F5F5;
}

.series-card__badge {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #FFFFFF;
  background: #1F3A44;
  height: 38rpx;
  line-height: 38rpx;
  padding: 0 14rpx;
  border-radius: 10rpx;
  letter-spacing: 1rpx;
}

.series-card__badge.is-accent {
  background: #F0A22E;
}

.series-card__body {
  padding: 20rpx 22rpx 26rpx;
  display: flex;
  flex-direction: column;
}

.series-card__name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D2226;
}

.series-card__tag {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #5C666B;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ============ 品牌实力 ============ */
.values {
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(31, 58, 68, 0.08);
  padding: 8rpx 28rpx;
}

.value {
  display: flex;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #E2DDD3;
}

.value:last-child {
  border-bottom: none;
}

.value__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #1F3A44;
  margin: 14rpx 20rpx 0 0;
  flex: none;
}

.value__text {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.value__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D2226;
}

.value__desc {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #5C666B;
  line-height: 1.65;
}

/* ============ 证书横滑 ============ */
.cert-scroll {
  width: 100%;
  white-space: nowrap;
}

.cert-row {
  display: flex;
  padding-bottom: 8rpx;
}

.cert-card {
  flex: none;
  width: 260rpx;
  margin-right: 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 24rpx rgba(31, 58, 68, 0.08);
  overflow: hidden;
}

.cert-card:last-child {
  margin-right: 0;
}

.cert-card__pic {
  height: 300rpx;
  background: #FFFFFF;
}

.cert-card__title {
  display: block;
  padding: 16rpx 18rpx 22rpx;
  font-size: 22rpx;
  color: #3A4348;
  line-height: 1.5;
  white-space: normal;
}

/* ============ 服务场景 ============ */
.scenes {
  display: flex;
  flex-wrap: wrap;
}

.scene {
  font-size: 26rpx;
  color: #3A4348;
  background: #FFFFFF;
  border: 1rpx solid #E2DDD3;
  height: 68rpx;
  line-height: 66rpx;
  padding: 0 30rpx;
  border-radius: 34rpx;
  margin: 0 20rpx 20rpx 0;
}

/* ============ 联系我们 ============ */
.cta {
  margin: 8rpx 32rpx 0;
  padding: 44rpx 36rpx;
  border-radius: 24rpx;
  background: linear-gradient(150deg, #16292F 0%, #1F3A44 100%);
  box-shadow: 0 12rpx 32rpx rgba(31, 58, 68, 0.22);
}

.cta__body {
  display: flex;
  flex-direction: column;
}

.cta__title {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.cta__desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
  line-height: 1.6;
}

.cta__actions {
  display: flex;
  margin-top: 36rpx;
}

.cta__btn {
  flex: 1;
  height: 84rpx;
  border-radius: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.cta__btn--solid {
  background: #FFFFFF;
  color: #16292F;
  margin-right: 18rpx;
}

.cta__btn--ghost {
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  color: #FFFFFF;
}

/* ============ 招商加盟 ============ */
.biz {
  margin: 32rpx 32rpx 0;
  padding: 40rpx 34rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  border: 2rpx solid #E8EDEE;
  box-shadow: 0 6rpx 24rpx rgba(31, 58, 68, 0.08);
  display: flex;
  flex-direction: column;
}

.biz__head {
  display: flex;
  align-items: center;
}

.biz__badge {
  font-size: 20rpx;
  font-weight: 700;
  color: #FFFFFF;
  background: #F0A22E;
  height: 38rpx;
  line-height: 38rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.biz__title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1D2226;
}

.biz__desc {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #5C666B;
  line-height: 1.8;
}

.biz__points {
  display: flex;
  flex-wrap: wrap;
  margin-top: 22rpx;
}

.biz__point {
  font-size: 22rpx;
  color: #1F3A44;
  background: #E8EDEE;
  height: 44rpx;
  line-height: 44rpx;
  padding: 0 20rpx;
  border-radius: 22rpx;
  margin: 0 14rpx 14rpx 0;
}

.biz__actions {
  display: flex;
  margin-top: 26rpx;
}

.biz__btn {
  flex: 1;
  height: 82rpx;
  border-radius: 41rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  font-weight: 600;
}

.biz__btn--solid {
  background: #1F3A44;
  color: #FFFFFF;
  margin-right: 18rpx;
}

.biz__btn--ghost {
  background: #FFFFFF;
  color: #1F3A44;
  border: 2rpx solid #1F3A44;
}

/* ============ 页脚 ============ */
.footer {
  margin-top: 56rpx;
  padding: 48rpx 48rpx 40rpx;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-top: 1rpx solid #E2DDD3;
}

.footer__brand {
  font-size: 26rpx;
  font-weight: 600;
  color: #3A4348;
}

.footer__line {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #8A9298;
  text-align: center;
}

.footer__links {
  display: flex;
  align-items: center;
  margin-top: 26rpx;
}

.footer__link {
  font-size: 22rpx;
  color: #1F3A44;
}

.footer__dot {
  font-size: 22rpx;
  color: #8A9298;
  margin: 0 14rpx;
}

.footer__copy {
  margin-top: 22rpx;
  font-size: 20rpx;
  color: #8A9298;
}
