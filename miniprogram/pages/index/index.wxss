/**index.wxss —— 构建产物（由 index.less 编译而来）**/
@import "../../components/tab-bar/tab-bar.wxss";

.page {
  background: #F5F7F6;
}

/* ============ 品牌首屏 ============ */
.hero {
  position: relative;
  margin-top: -1px;
  padding: 0 48rpx 64rpx;
  background: linear-gradient(165deg, #0A4A37 0%, #0F6B4F 52%, #13795A 100%);
  overflow: hidden;
}

.hero__glow {
  position: absolute;
  right: -160rpx;
  top: -180rpx;
  width: 560rpx;
  height: 560rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.16) 0%, rgba(255, 255, 255, 0) 68%);
}

.hero__brand {
  position: relative;
  display: flex;
  align-items: center;
  padding-top: 24rpx;
}

.hero__mark {
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.14);
  border: 2rpx solid rgba(255, 255, 255, 0.34);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.hero__mark-text {
  font-size: 44rpx;
  color: #FFFFFF;
  font-weight: 700;
}

.hero__brand-text {
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
}

.hero__brand-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 6rpx;
}

.hero__brand-tag {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.6);
  letter-spacing: 4rpx;
}

.hero__title {
  position: relative;
  display: block;
  margin-top: 56rpx;
  font-size: 52rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.34;
  letter-spacing: 2rpx;
}

.hero__desc {
  position: relative;
  display: block;
  margin-top: 20rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.78);
  line-height: 1.7;
}

.hero__tags {
  position: relative;
  display: flex;
  flex-wrap: wrap;
  margin-top: 32rpx;
}

.hero__tag {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.92);
  background: rgba(255, 255, 255, 0.13);
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  height: 44rpx;
  line-height: 42rpx;
  padding: 0 20rpx;
  border-radius: 22rpx;
  margin: 0 16rpx 0 0;
}

.hero__actions {
  position: relative;
  display: flex;
  margin-top: 48rpx;
}

.hero__btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
}

.hero__btn--solid {
  background: #FFFFFF;
  color: #0A4A37;
  margin-right: 20rpx;
}

.hero__btn--ghost {
  border: 2rpx solid rgba(255, 255, 255, 0.55);
  color: #FFFFFF;
}

/* ============ 核心卖点 ============ */
.features {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -10rpx;
}

.feature {
  width: 50%;
  padding: 0 10rpx 20rpx;
  display: flex;
  flex-direction: column;
}

.feature__no {
  font-size: 34rpx;
  font-weight: 700;
  color: #0F6B4F;
  line-height: 1.2;
}

.feature__title {
  margin-top: 10rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #16211D;
}

.feature__desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #6B7B75;
  line-height: 1.6;
}

/* ============ 系列横滑 ============ */
.series-scroll {
  width: 100%;
  white-space: nowrap;
}

.series-row {
  display: flex;
  padding-bottom: 8rpx;
}

.series-card {
  flex: none;
  width: 320rpx;
  margin-right: 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(15, 107, 79, 0.08);
  overflow: hidden;
}

.series-card:last-child {
  margin-right: 0;
}

.card-hover {
  opacity: 0.88;
}

.series-card__pic {
  position: relative;
  height: 240rpx;
  background: #F2F8F5;
}

.series-card__badge {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #FFFFFF;
  background: #0F6B4F;
  height: 38rpx;
  line-height: 38rpx;
  padding: 0 14rpx;
  border-radius: 10rpx;
  letter-spacing: 1rpx;
}

.series-card__badge.is-accent {
  background: #C2703E;
}

.series-card__body {
  padding: 20rpx 22rpx 26rpx;
  display: flex;
  flex-direction: column;
}

.series-card__name {
  font-size: 28rpx;
  font-weight: 600;
  color: #16211D;
}

.series-card__tag {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #6B7B75;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ============ 品牌实力 ============ */
.values {
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(15, 107, 79, 0.08);
  padding: 8rpx 28rpx;
}

.value {
  display: flex;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #E3E9E6;
}

.value:last-child {
  border-bottom: none;
}

.value__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #0F6B4F;
  margin: 14rpx 20rpx 0 0;
  flex: none;
}

.value__text {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.value__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #16211D;
}

.value__desc {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #6B7B75;
  line-height: 1.65;
}

/* ============ 产品短视频 ============ */
.vscroll {
  width: 100%;
  white-space: nowrap;
}

.vrow {
  display: flex;
  padding-bottom: 8rpx;
}

.vcard {
  flex: none;
  width: 280rpx;
  margin-right: 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 24rpx rgba(15, 107, 79, 0.08);
  overflow: hidden;
}

.vcard:last-child {
  margin-right: 0;
}

.vcard__pic {
  position: relative;
  height: 360rpx;
  background: #0A1712;
}

.vcard__play {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 72rpx;
  height: 72rpx;
  margin: -36rpx 0 0 -36rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.42);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
}

.vcard__triangle {
  width: 0;
  height: 0;
  margin-left: 6rpx;
  border-left: 18rpx solid #FFFFFF;
  border-top: 12rpx solid transparent;
  border-bottom: 12rpx solid transparent;
}

.vcard__title {
  display: block;
  padding: 16rpx 18rpx 22rpx;
  font-size: 23rpx;
  color: #3D4A45;
  line-height: 1.5;
  white-space: normal;
}

/* ============ 证书横滑 ============ */
.cert-scroll {
  width: 100%;
  white-space: nowrap;
}

.cert-row {
  display: flex;
  padding-bottom: 8rpx;
}

.cert-card {
  flex: none;
  width: 260rpx;
  margin-right: 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 24rpx rgba(15, 107, 79, 0.08);
  overflow: hidden;
}

.cert-card:last-child {
  margin-right: 0;
}

.cert-card__pic {
  height: 300rpx;
  background: #FFFFFF;
}

.cert-card__title {
  display: block;
  padding: 16rpx 18rpx 22rpx;
  font-size: 22rpx;
  color: #3D4A45;
  line-height: 1.5;
  white-space: normal;
}

/* ============ 服务场景 ============ */
.scenes {
  display: flex;
  flex-wrap: wrap;
}

.scene {
  font-size: 26rpx;
  color: #3D4A45;
  background: #FFFFFF;
  border: 1rpx solid #E3E9E6;
  height: 68rpx;
  line-height: 66rpx;
  padding: 0 30rpx;
  border-radius: 34rpx;
  margin: 0 20rpx 20rpx 0;
}

/* ============ 联系我们 ============ */
.cta {
  margin: 8rpx 32rpx 0;
  padding: 44rpx 36rpx;
  border-radius: 24rpx;
  background: linear-gradient(150deg, #0A4A37 0%, #0F6B4F 100%);
  box-shadow: 0 12rpx 32rpx rgba(15, 107, 79, 0.22);
}

.cta__body {
  display: flex;
  flex-direction: column;
}

.cta__title {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.cta__desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
  line-height: 1.6;
}

.cta__actions {
  display: flex;
  margin-top: 36rpx;
}

.cta__btn {
  flex: 1;
  height: 84rpx;
  border-radius: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.cta__btn--solid {
  background: #FFFFFF;
  color: #0A4A37;
  margin-right: 18rpx;
}

.cta__btn--ghost {
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  color: #FFFFFF;
}

/* ============ 页脚 ============ */
.footer {
  margin-top: 56rpx;
  padding: 48rpx 48rpx 40rpx;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-top: 1rpx solid #E3E9E6;
}

.footer__brand {
  font-size: 26rpx;
  font-weight: 600;
  color: #3D4A45;
}

.footer__line {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #9AA8A2;
  text-align: center;
}

.footer__links {
  display: flex;
  align-items: center;
  margin-top: 26rpx;
}

.footer__link {
  font-size: 22rpx;
  color: #0F6B4F;
}

.footer__dot {
  font-size: 22rpx;
  color: #9AA8A2;
  margin: 0 14rpx;
}

.footer__copy {
  margin-top: 22rpx;
  font-size: 20rpx;
  color: #9AA8A2;
}
