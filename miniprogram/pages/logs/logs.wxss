/**logs.wxss —— 构建产物（由 logs.less 编译而来）**/
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #FFFFFF;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.log-item {
  display: flex;
  align-items: center;
  padding: 26rpx 40rpx;
  border-bottom: 1rpx solid #E3E9E6;
}

.log-item__no {
  width: 60rpx;
  flex: none;
  font-size: 24rpx;
  color: #9AA8A2;
}

.log-item__date {
  font-size: 26rpx;
  color: #3D4A45;
}

.empty {
  padding: 160rpx 0;
  display: flex;
  justify-content: center;
}

.empty__text {
  font-size: 26rpx;
  color: #9AA8A2;
}
