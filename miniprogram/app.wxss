/**app.wxss —— 全局样式（由 app.less + theme.less 编译而来，构建产物）**/
page {
  background: #FFFFFF;
  color: #1D2226;
  font-size: 28rpx;
  line-height: 1.6;
  font-family: "PingFang SC", "Microsoft YaHei", "Helvetica Neue", Helvetica, Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
}

view,
text,
image,
button,
input,
textarea {
  box-sizing: border-box;
}

/* 页面容器 */
.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.content {
  flex: 1;
}

/* 底部留白（tabBar 页用） */
.pad-tabbar {
  height: calc(40rpx + env(safe-area-inset-bottom));
}

/* ============ 通用排版 ============ */
.section {
  padding: 48rpx 40rpx;
}

.section--tight {
  padding-top: 0;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 28rpx;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid #D8D2C6;
}

.section-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1D2226;
  letter-spacing: 1rpx;
}

.section-sub {
  font-size: 23rpx;
  color: #5C666B;
  margin-top: 8rpx;
}

.section-more {
  font-size: 26rpx;
  color: #1F3A44;
  display: flex;
  align-items: center;
  flex: none;
}

.arrow {
  font-size: 26rpx;
  margin-left: 4rpx;
}

.card {
  background: #FFFFFF;
  border: 1rpx solid #D8D2C6;
  border-radius: 0;
  box-shadow: none;
  overflow: hidden;
}

.divider {
  height: 1rpx;
  background: #D8D2C6;
}

/* ============ 按钮 ============ */
.btn-primary,
.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: 0;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1;
}

.btn-primary {
  background: #1F3A44;
  color: #FFFFFF;
}

.btn-primary--block {
  width: 100%;
}

.btn-ghost {
  background: #FFFFFF;
  color: #1F3A44;
  border: 2rpx solid #1F3A44;
}

.btn-hover {
  opacity: 0.85;
}

button {
  padding: 0;
  margin: 0;
  background: transparent;
  line-height: normal;
}

button::after {
  border: none;
}

/* ============ 标签 ============ */
.tag {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 0;
  font-size: 21rpx;
  background: #FFFFFF;
  border: 1rpx solid #D8D2C6;
  color: #1F3A44;
  margin: 0 10rpx 10rpx 0;
}

.tag--accent {
  background: #FDF3E3;
  color: #F0A22E;
}

.tag--plain {
  background: #F7F5F0;
  color: #5C666B;
}

/* ============================================================
   v47 宣传册风格工具类
   用法：中文主标题 + 英文 kicker（宣传册每页都是这个结构）
   ============================================================ */

/* 英文小标签：位于中文标题上方或下方，字距略宽 */
.kicker {
  display: block;
  font-family: Arial, "Helvetica Neue", sans-serif;
  font-size: 21rpx;
  letter-spacing: 2rpx;
  color: #2F6FB2;
  margin-bottom: 8rpx;
  text-transform: uppercase;
}

/* 橙色编号 01 / 02 */
.num {
  display: block;
  font-family: Arial, "Helvetica Neue", sans-serif;
  font-size: 42rpx;
  font-weight: 700;
  color: #F0A22E;
  line-height: 1;
}

/* 页面主标题（30pt） */
.h1 {
  font-size: 52rpx;
  font-weight: 700;
  color: #1F3A44;
  letter-spacing: 1rpx;
  line-height: 1.25;
}

/* 卡片标题（21pt） */
.h2 {
  font-size: 38rpx;
  font-weight: 700;
  color: #1F3A44;
  line-height: 1.35;
}

/* 正文（15pt） */
.body {
  font-size: 28rpx;
  color: #1D2226;
  line-height: 1.85;
}

/* 注释（10.5pt） */
.caption {
  font-size: 22rpx;
  color: #5C666B;
  line-height: 1.7;
}

/* 篇章分隔页（PART 05 政策支持），深底大字 */
.part {
  position: relative;
  overflow: hidden;
  padding: 64rpx 40rpx 60rpx;
  background: #1F3A44;
  display: flex;
  flex-direction: column;
}

.part__no {
  position: relative;
  font-family: Arial, "Helvetica Neue", sans-serif;
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: #F0A22E;
}

.part__title {
  position: relative;
  margin-top: 14rpx;
  font-size: 72rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 4rpx;
  line-height: 1.15;
}

.part__en {
  position: relative;
  margin-top: 12rpx;
  font-family: Arial, "Helvetica Neue", sans-serif;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #F4F1EA;
}

.part__desc {
  position: relative;
  margin-top: 20rpx;
  max-width: 70%;
  font-size: 26rpx;
  color: rgba(244, 241, 234, 0.88);
  line-height: 1.8;
}

/* 暖色卡片：宣传册的米色底块 */
.card-warm {
  background: #FFFFFF;
  border: 1rpx solid #D8D2C6;
  border-radius: 0;
}

/* 引用/出处块 */
.ref {
  padding: 20rpx 24rpx;
  background: #FBF6EA;
  border-left: 6rpx solid #F0A22E;
  border-radius: 0;
}

.ref__text {
  font-size: 22rpx;
  color: #5C666B;
  line-height: 1.7;
}

/* ============================================================
   以下按 v47 design_spec 补充
   规范要点：白底正文页 / 圆角 0 / 无阴影 / 分隔线 #D8D2C6
            英文副行 #2F6FB2 / 橙色对角切角为全册母题
   ============================================================ */

/* 1px 结构线 */
.rule {
  height: 1rpx;
  background: #D8D2C6;
  margin: 24rpx 0;
}

/* 图片底衬（规范：Secondary background #F4F1EA） */
.figure {
  background: #F4F1EA;
}

/* 说明条 / 次级色块 */
.strip {
  padding: 20rpx 24rpx;
  background: #F4F1EA;
  border-left: 4rpx solid #F0A22E;
}

.strip__text {
  font-size: 22rpx;
  color: #5C666B;
  line-height: 1.75;
}

/* 橙色对角切角：全册母题，放在相对定位容器内绝对定位 */
.chamfer {
  position: absolute;
  top: 0;
  right: 0;
  pointer-events: none;
  /* 用渐变切出对角三角，避免 clip-path 兼容性与旋转方块越界盖字 */
  background: linear-gradient(225deg, #F0A22E 50%, rgba(240, 162, 46, 0) 50%);
}

/* 首屏右上角小切角（不压文字） */
.chamfer--tr {
  width: 240rpx;
  height: 240rpx;
}

/* 篇章页右上角大切角 */
.chamfer--part {
  width: 320rpx;
  height: 320rpx;
}

/* 小节标题左侧的短橙条 */
.chamfer--mark {
  position: absolute;
  top: 8rpx;
  left: 0;
  width: 8rpx;
  height: 40rpx;
  background: #F0A22E;
}

/* 深色页脚带（品牌 + 页码） */
.band {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 40rpx;
  background: #1F3A44;
}

.band__text {
  font-family: Arial, "Helvetica Neue", sans-serif;
  font-size: 18rpx;
  letter-spacing: 1rpx;
  color: #F4F1EA;
}

/* 页面标题组：英文小标 + 中文大标 + 英文副行 */
.headline {
  display: flex;
  flex-direction: column;
}

.headline__en {
  font-family: Arial, "Helvetica Neue", sans-serif;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: #2F6FB2;
}

.headline__zh {
  margin-top: 6rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #1F3A44;
  letter-spacing: 1rpx;
  line-height: 1.25;
}


/* ============================================================
   模块标题：橙色短竖条 + 中文标题 + 右侧英文（参考永耐 sec-bar）
   ============================================================ */

/* 标题前的橙色短竖条（8×32rpx，与永耐一致） */
.section-title::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 36rpx;
  border-radius: 4rpx;
  background: #F0A22E;
  margin-right: 16rpx;
  vertical-align: middle;
  transform: translateY(-2rpx);
}

/* 标题行：中文标题 + 右侧英文小标 */
.section-title-row {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

/* 英文小标（永耐 .sec-en：18rpx / 600 / #B3A98F / 字距 2rpx / 大写） */
.section-en {
  margin-left: 14rpx;
  font-family: Arial, "Helvetica Neue", sans-serif;
  font-size: 18rpx;
  font-weight: 600;
  color: #B3A98F;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}
