<!--
  mkimg —— 带占位与淡入的图片
  图片缺失或加载失败时，显示浅色占位块 + 品牌水印，而不是破图图标。
-->
<view class="mkimg mkimg--{{shape}} {{failed ? 'is-failed' : ''}}" style="{{style}}">
  <view class="mkimg__ph" wx:if="{{!ready}}">
    <text class="mkimg__ph-text">{{phText}}</text>
  </view>
  <image
    wx:if="{{!failed}}"
    class="mkimg__img {{ready ? 'is-ready' : ''}}"
    src="{{src}}"
    mode="{{mode}}"
    lazy-load="{{true}}"
    show-menu-by-longpress="{{longpress}}"
    bindload="onLoad"
    binderror="onError"
  ></image>
</view>
