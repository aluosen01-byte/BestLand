/* tab-bar.wxss —— 构建产物（由 tab-bar.less 编译而来；页面内会 @import 本文件） */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: #ffffff;
  border-top: 1rpx solid #e3e9e6;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -6rpx 24rpx rgba(15, 107, 79, 0.06);
}

.tabbar__inner {
  display: flex;
  align-items: center;
  height: 104rpx;
}

.tabbar__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
}

.tabbar__item--hover {
  opacity: 0.7;
}

.tabbar__icon {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 4rpx;
}

.tabbar__label {
  font-size: 20rpx;
  color: #8a9691;
  line-height: 1.2;
}

.tabbar__item.is-on .tabbar__label {
  color: #0f6b4f;
  font-weight: 600;
}
