# 默认让 git 自动判断文本/二进制
* text=auto

# 明确标记二进制，避免任何换行符转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.rar  binary
*.pptx binary

# 文本文件统一使用 LF 行尾
*.ts   text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.wxml text eol=lf
*.wxss text eol=lf
*.less text eol=lf
*.md   text eol=lf
*.svg  text eol=lf
*.txt  text eol=lf
